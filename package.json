{
  "name": "@warpgogol/warpgogol-billing-cloudflare",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/warpgogol-billing-cloudflare.git"
  },
  "description": "Cloudflare D1 storage adapter for the billing read projection.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build:check && pnpm run test",
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@warpgogol/warpgogol-billing-core": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.10.0"
}
